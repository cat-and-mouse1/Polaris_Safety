<?xml version="1.0" encoding="utf-8"?>
<!-- Root 模式：斜放 45° 的钥匙（解锁最高权限） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="45">
        <!-- 钥匙柄（圆环） -->
        <path
            android:pathData="M9.5,7 A3.5,3.5 0 1 0 9.5,14 A3.5,3.5 0 1 0 9.5,7 Z"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.9" />
        <!-- 钥匙杆 -->
        <path
            android:pathData="M13,10.5 L21,10.5"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.9"
            android:strokeLineCap="round" />
        <!-- 钥匙齿 -->
        <path
            android:pathData="M17.5,10.5 L17.5,13.5 M20,10.5 L20,13"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.7"
            android:strokeLineCap="round" />
    </group>
</vector>
