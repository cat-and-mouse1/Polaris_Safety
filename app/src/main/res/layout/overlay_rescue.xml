<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_scrim"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- 四芒星图标 -->
    <ImageView
        android:id="@+id/rescueStar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@string/star_desc"
        android:src="@drawable/ic_star"
        android:tint="@color/text_on_solid" />

    <!-- 救援提示文案（纯红） -->
    <TextView
        android:id="@+id/rescueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="@string/rescue_title"
        android:textColor="@color/rescue_danger"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 清除 / 放行 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rescueClear"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/rescue_danger"
            android:text="@string/rescue_clear"
            android:textColor="@color/text_on_solid"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/rescueAllow"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/rescue_safe"
            android:text="@string/rescue_allow"
            android:textColor="@color/text_on_solid"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
