<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <!-- 星图底座：表面色底 + StarMapView 氛围层（半透明网格 / 星点 / 闪烁亮星） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface">

            <com.polaris.app.view.StarMapView
                android:id="@+id/starMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 天文台入场动画层：盖住星图但位于主内容之下，
                 所以范围选择面板（configScope）能正常浮在这幕之上 -->
            <com.polaris.app.view.ObservatoryIntroView
                android:id="@+id/observatoryIntro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- 火箭发射入场动画层（深层扫描模式）：同层级，盖住星图但位于主内容之下 -->
            <com.polaris.app.view.RocketIntroView
                android:id="@+id/rocketIntro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- 主内容 -->
            <LinearLayout
                android:id="@+id/contentRoot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:fitsSystemWindows="true">

            <!-- 头部：展开侧栏 / 徽章 + 标题 / 打开工具箱 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="16dp">

                <!-- 展开侧栏（守护面板） -->
                <ImageButton
                    android:id="@+id/btnDrawer"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/drawer_open"
                    android:src="@drawable/ic_menu"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 头部徽标行：小四角星（左） + 欢迎文字（右）；圆环视图保留 id 供扫描进度逻辑调用，视觉隐藏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="10dp">

                <FrameLayout
                    android:id="@+id/homeAppIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp">

                    <com.polaris.app.view.ConcentricRingsView
                        android:id="@+id/homeRings"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/homeStar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/star_desc"
                        android:src="@drawable/ic_star"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/homeGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 扫描状态行（统计 / 当前文件与应用名），扫描中显示 -->
            <TextView
                android:id="@+id/scanStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="start"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:paddingHorizontal="20dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <!-- 阶段区：模式 / 方式 / 范围 / 结果 互斥显示，滑动切换 -->
            <FrameLayout
                android:id="@+id/stageArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3.2">

                <!-- 模式选择：上方详细面板（点击图标后浮现）+ 一行四个纯图标按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical">

                    <!-- 详细面板容器：detailCard + 可展开的检查逻辑卡（竖排，展开时向上推） -->
                    <LinearLayout
                        android:id="@+id/modeDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/modeList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="14dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- 范围选择面板 -->
                <LinearLayout
                    android:id="@+id/configScope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/scan_scope_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/scopeOptGlobal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/scan_scope_global"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/scan_scope_global_desc"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/scopeCheckGlobal"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check"
                                android:visibility="gone"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/scopeOptFolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/scan_scope_folder"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/scan_scope_folder_desc"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/scopeCheckFolder"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check"
                                android:visibility="gone"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/scopeOptApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/scan_scope_apps"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/scan_scope_apps_desc"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/scopeCheckApps"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check"
                                android:visibility="gone"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="14dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scopeBack"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@string/scan_back"
                            app:cornerRadius="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scopeStart"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/toast_scan_start"
                            app:cornerRadius="20dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 文件夹选择面板（可添加多个文件夹；内容多时可滚动） -->
                <ScrollView
                    android:id="@+id/configFolders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/scan_folders_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="2dp"
                        android:text="@string/scan_folders_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/folderEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="@string/scan_folder_empty"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:id="@+id/folderListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/folderAddButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/scan_folder_add"
                        app:cornerRadius="20dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="14dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/folderBack"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@string/scan_back"
                            app:cornerRadius="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/folderStart"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/toast_scan_start"
                            app:cornerRadius="20dp" />
                    </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- 结果区：竖屏顶部停在四角星下方（topMargin 由代码按图标底边动态计算，此处为静态默认值） -->
                <LinearLayout
                    android:id="@+id/resultArea"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="158dp"
                    android:background="?attr/colorSurface"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 结果页顶部：百分制评分（大号主题色分数 + 灰色 /100）+ 右侧结果计数 -->
                    <LinearLayout
                        android:id="@+id/resultScoreRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/resultScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/result_score_placeholder"
                            android:textAppearance="?attr/textAppearanceDisplayMedium"
                            android:textColor="?attr/colorPrimary"
                            android:shadowColor="?attr/colorPrimary"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="8" />

                        <TextView
                            android:id="@+id/resultScoreMax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/result_score_max"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- 分数右侧简要说明：文件/应用各自的风险计数（逐段显示） -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/resultBriefFiles"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/resultBriefApps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- 向下收回：点击把结果页滑回星图 -->
                        <ImageButton
                            android:id="@+id/resultCollapse"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="-6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/result_collapse_desc"
                            android:src="@drawable/ic_expand_more" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                        <!-- 双段都有结果时显示的分栏选择（文件 / 应用）；单段时隐藏 -->
                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/resultTabs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="2dp"
                            android:visibility="gone"
                            app:checkedButton="@+id/tabFiles"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <Button
                                android:id="@+id/tabFiles"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/result_tab_files" />

                            <Button
                                android:id="@+id/tabApps"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/result_tab_apps" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <!-- 文件段面板：扫描范围 + 文件总数 + 段评分 + 可折叠文件结果 -->
                        <LinearLayout
                            android:id="@+id/filePanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginTop="10dp"
                            android:padding="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/fileMetaText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginTop="6dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/fileScoreText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorPrimary" />

                            <LinearLayout
                                android:id="@+id/resultList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingBottom="8dp" />
                        </LinearLayout>

                        <!-- 应用段面板：应用总数 + 段评分 + 可折叠应用结果（逐应用评分） -->
                        <LinearLayout
                            android:id="@+id/appPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginTop="10dp"
                            android:padding="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/appMetaText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginTop="6dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/appScoreText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorPrimary" />

                            <LinearLayout
                                android:id="@+id/appResultList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingBottom="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/resultBack"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@string/scan_back_to_modes"
                            app:cornerRadius="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/resultAgain"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/scan_again"
                            app:cornerRadius="20dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 无激活模式时：左下角「选择模式以开始扫描」；点击后平移到右下角变「下一步」。
                     必须是 stageArea 最后一个子 view：展开的模式列表声明在前，按钮需浮在其上层 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickBack"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="16dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/scan_back"
                    android:visibility="gone"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickMode"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="16dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/mode_pick_to_start"
                    app:cornerRadius="24dp" />
            </FrameLayout>

            <!-- 底部弹性占位（权重小，主要吸收系统导航栏差异） -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0.2" />

        </LinearLayout>

        <!-- 已有激活模式时的快捷面板：左下角「以（模式）开始扫描」+ 右侧「重新配置模式」，底部与缩放条对齐 -->
        <LinearLayout
            android:id="@+id/modeResume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 应用行为面板：默认隐藏（保留视图供 BehaviorLog 逻辑引用） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/behaviorPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/behavior_panel_title"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:id="@+id/behaviorRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/behaviorEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/behavior_empty"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 拦截入口：深层扫描模式显示（代码控制显隐），直达扫描中心拦截板块 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResumeBlock"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_block"
                android:visibility="gone"
                app:cornerRadius="22dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResumeScan"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/scan_next"
                    app:cornerRadius="26dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReconfigureMode"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/mode_reconfigure" />
            </LinearLayout>
        </LinearLayout>

        <!-- 星图缩放条：底部右侧（扫描星域激活时显示，与捏合手势双向同步） -->
        <com.google.android.material.slider.Slider
            android:id="@+id/zoomSlider"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:value="1"
            android:valueFrom="0.4"
            android:valueTo="4.5"
            android:visibility="gone"
            app:labelBehavior="gone"
            app:thumbRadius="4dp"
            app:trackHeight="4dp" />

        <!-- 扫描进度面板：底部横贯（全局条=整体进度；局部亮条=当前对象进度；左上文字=当前对象） -->
        <LinearLayout
            android:id="@+id/scanProgressPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/scanObjText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@drawable/scan_progress_track">

                <View
                    android:id="@+id/progressGlobalBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/scan_progress_global" />

                <View
                    android:id="@+id/progressLocalBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/scan_progress_local" />
            </FrameLayout>
        </LinearLayout>

        <!-- 扫描完成入口：左下角横块，点击查看扫描结果 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultEntryBar"
            android:layout_width="180dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/entryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/scan_view_results"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurface" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 恒星详情面板：点按恒星从右侧划出并占满整个高度（宽/位置由代码按方向动态设置） -->
        <include
            android:id="@+id/starDetailPanel"
            layout="@layout/layout_star_detail_panel"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginEnd="0dp" />

        <!-- 拦截模式地下功能面板容器：点击拦截按钮后由火箭动画揭示，
             盖在内容层之上、仅占据屏幕下方（地面以下）区域，默认 gone -->
        <FrameLayout
            android:id="@+id/interceptUnderground"
            android:layout_width="match_parent"
            android:layout_height="560dp"
            android:layout_gravity="bottom"
            android:visibility="gone">
            <include layout="@layout/intercept_underground_panel" />
        </FrameLayout>
    </FrameLayout>

        <!-- 左侧守护面板 -->
        <include
            android:id="@+id/guardDashboard"
            layout="@layout/layout_guard_dashboard"
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:layout_gravity="start" />

    </androidx.drawerlayout.widget.DrawerLayout>


    <!-- 下拉面板：全屏工具箱（权限使用 / 最近文件） -->
    <include
        layout="@layout/layout_pulldown_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
