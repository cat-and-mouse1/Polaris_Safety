<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <!-- 主内容：横屏左右分栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:orientation="horizontal"
            android:fitsSystemWindows="true">

            <!-- 左栏：头部 + 四角星图标 + 圆环 + 扫描状态 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="16dp">

                <!-- 头部：展开侧栏 / 打开工具箱 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnDrawer"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/drawer_open"
                        android:src="@drawable/ic_menu"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btnToolbox"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/tools_title"
                        android:src="@drawable/ic_toolbox"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <!-- 图标区：剩余空间垂直居中 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical">

                    <!-- 应用图标：中心四角星 + 外圈 3 圈同心圆环 -->
                    <FrameLayout
                        android:id="@+id/homeAppIcon"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center_horizontal">

                    <com.polaris.app.view.ConcentricRingsView
                        android:id="@+id/homeRings"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <FrameLayout
                        android:id="@+id/homeIconDisc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_mode_badge">

                        <ImageView
                            android:id="@+id/homeStar"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/star_desc"
                            android:src="@drawable/ic_star" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/scanStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:paddingHorizontal="20dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 右栏：模式选择 + 滑动界面（头部占位与左栏头部等高，保证两栏中线对齐） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:orientation="vertical">

                <!-- 与左栏头部等高的占位（16dp padding + 44dp 按钮 = 60dp） -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="60dp" />

                <FrameLayout
                    android:id="@+id/stageArea"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <!-- 模式列表（代码动态填充） -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <LinearLayout
                            android:id="@+id/modeList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </ScrollView>

                    <!-- 范围选择面板（与模式卡同区域、垂直居中） -->
                    <LinearLayout
                        android:id="@+id/configScope"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="4dp"
                            android:text="@string/scan_scope_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/scopeOptGlobal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/scan_scope_global"
                                        android:textAppearance="?attr/textAppearanceTitleSmall"
                                        android:textColor="?attr/colorOnSurface" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/scan_scope_global_desc"
                                        android:textAppearance="?attr/textAppearanceBodySmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/scopeCheckGlobal"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_marginStart="10dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone"
                                    app:tint="?attr/colorPrimary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/scopeOptFolder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/scan_scope_folder"
                                        android:textAppearance="?attr/textAppearanceTitleSmall"
                                        android:textColor="?attr/colorOnSurface" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/scan_scope_folder_desc"
                                        android:textAppearance="?attr/textAppearanceBodySmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/scopeCheckFolder"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_marginStart="10dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone"
                                    app:tint="?attr/colorPrimary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/scopeOptApps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/scan_scope_apps"
                                        android:textAppearance="?attr/textAppearanceTitleSmall"
                                        android:textColor="?attr/colorOnSurface" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/scan_scope_apps_desc"
                                        android:textAppearance="?attr/textAppearanceBodySmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/scopeCheckApps"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_marginStart="10dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone"
                                    app:tint="?attr/colorPrimary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="14dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/scopeBack"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="@string/scan_back"
                                app:cornerRadius="20dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/scopeStart"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:text="@string/toast_scan_start"
                                app:cornerRadius="20dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 文件夹选择面板 -->
                    <ScrollView
                        android:id="@+id/configFolders"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingBottom="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginTop="4dp"
                                android:text="@string/scan_folders_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginTop="2dp"
                                android:text="@string/scan_folders_hint"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/folderEmptyText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginTop="18dp"
                                android:gravity="center"
                                android:text="@string/scan_folder_empty"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <LinearLayout
                                android:id="@+id/folderListContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/folderAddButton"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginTop="10dp"
                                android:text="@string/scan_folder_add"
                                app:cornerRadius="20dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginTop="14dp"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/folderBack"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:text="@string/scan_back"
                                    app:cornerRadius="20dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/folderStart"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/toast_scan_start"
                                    app:cornerRadius="20dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>

                    <!-- 结果区 -->
                    <LinearLayout
                        android:id="@+id/resultArea"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/resultTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="4dp"
                            android:text="@string/scan_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:fillViewport="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/fileSectionTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="16dp"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorPrimary" />

                                <LinearLayout
                                    android:id="@+id/resultList"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:paddingBottom="8dp" />

                                <TextView
                                    android:id="@+id/appSectionTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="16dp"
                                    android:layout_marginTop="10dp"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorPrimary" />

                                <LinearLayout
                                    android:id="@+id/appResultList"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:paddingBottom="8dp" />
                            </LinearLayout>
                        </ScrollView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/resultBack"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="@string/scan_back_to_modes"
                                app:cornerRadius="20dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/resultAgain"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:text="@string/scan_again"
                                app:cornerRadius="20dp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 左侧守护面板（横屏由 layout-land 适配） -->
        <include
            android:id="@+id/guardDashboard"
            layout="@layout/layout_guard_dashboard"
            android:layout_width="420dp"
            android:layout_height="match_parent"
            android:layout_gravity="start" />

    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- 下拉面板：全屏工具箱（横屏由 layout-land 适配） -->
    <include
        layout="@layout/layout_pulldown_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
