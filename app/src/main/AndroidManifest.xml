<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications for scan alerts (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AI 判定：调用大模型 API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 自行下载并安装更新 APK（Android 8+ 需用户授权「安装未知应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Periodic scan after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Enumerate all installed apps for heuristic scanning (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Foreground guard service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Optional: foreground-app detection via usage stats (user can grant in Settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 全局文件扫描（Android 11+ 需「所有文件访问」；低版本用 READ_EXTERNAL_STORAGE） -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".PolarisApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Polaris"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:theme="@style/Theme.Polaris" />

        <activity
            android:name=".AiSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Polaris" />

        <!-- 扫描中心：文件夹/全局文件扫描 + 隔离区管理 -->
        <activity
            android:name=".FileScanActivity"
            android:exported="false"
            android:theme="@style/Theme.Polaris" />

        <!-- 设置：重选守护模式 / 默认引擎 / 语言 / 主题 / AI 状态 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Polaris" />

        <!-- 应用信息：版本 / 更新日志 / 检查更新 -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.Polaris" />

        <!-- 应用内语言切换：持久化已选语言（AppCompat autoStoreLocales） -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Shizuku provider (required by dev.rikka.shizuku:provider) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Accessibility Mode: deep scan + foreground monitoring -->
        <service
            android:name=".service.PolarisAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Shizuku / Root Mode: always-on guard that blocks malicious apps -->
        <service
            android:name=".service.GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="security guard: monitor foreground apps and block malware" />
        </service>

        <!-- 拦截模式常驻通知的「关闭」动作接收器 -->
        <receiver
            android:name=".BlockOffReceiver"
            android:exported="false" />

        <!-- 更新 APK 安装：通过 FileProvider 暴露下载的 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
